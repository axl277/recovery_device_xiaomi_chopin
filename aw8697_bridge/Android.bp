//
// Makes TWRP/OrangeFox vibration work on chopin and lets the vibration slider
// control the strength (aw8697 haptic driver).
// SPDX-License-Identifier: Apache-2.0
//

cc_binary {
    name: "aw8697_haptic_bridge",
    srcs: ["aw8697_haptic_bridge.c"],
    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
    ],
    recovery_available: true,
    init_rc: ["aw8697_haptic_bridge.rc"],
}

on boot
    start aw8697.bridge

# Defaults can be changed here (e.g. add "--min=0x60 --max=0xff --pulse=70") or live
# with tools/vib_tune.bat while the recovery is running.
service aw8697.bridge /system/bin/aw8697_haptic_bridge
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0
